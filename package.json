{
  "name": "loxhuebridge",
  "version": "2.2.0",
  "description": "Philips Hue V2 to Loxone Bridge",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch data src/server.ts",
    "dev:frontend": "cd frontend && npm start",
    "dev:debug": "DEBUG=true ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch data src/server.ts",
    "dev:build": "tsc --watch",
    "dev:watch": "npm run build && pm2-dev start ecosystem.config.js --env development",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development --watch",
    "pm2:stop": "pm2 stop loxhuebridge",
    "pm2:restart": "pm2 restart loxhuebridge",
    "pm2:logs": "pm2 logs loxhuebridge",
    "pm2:status": "pm2 status",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration",
    "legacy": "node server.legacy.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-rsa": "^1.1.1",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@types/node-rsa": "^1.1.4",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "pm2": "^5.4.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
